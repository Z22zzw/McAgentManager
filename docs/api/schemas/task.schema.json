{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-ai-manager.local/schemas/task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "kind", "state", "actorId", "idempotencyKey", "version", "createdAt", "updatedAt"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["DEPLOY", "CONTROL", "CLEANUP", "DELETE", "DIAGNOSE", "RECONCILE"] },
    "state": { "type": "string", "enum": ["CREATED", "INSPECTING", "WAITING_USER", "QUEUED", "EXECUTING", "VERIFYING", "SUCCEEDED", "PARTIAL", "FAILED", "CANCELLED", "INTERRUPTED", "RECOVERING", "RECOVERY_REQUIRED"] },
    "actorId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "resourceId": { "type": "string" },
    "version": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "currentStep": { "$ref": "#/$defs/step" },
    "progress": { "type": "object", "additionalProperties": false, "required": ["completed", "total"], "properties": { "completed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } }
  },
  "$defs": {
    "step": { "type": "object", "additionalProperties": false, "required": ["stepId", "state"], "properties": { "stepId": { "type": "string" }, "state": { "type": "string", "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "UNKNOWN", "WAITING_USER"] }, "questionId": { "type": "string" } } }
  }
}
